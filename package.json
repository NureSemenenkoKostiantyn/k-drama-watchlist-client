{
  "name": "drama-watch-web",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "dev:compose": "ng serve --host 0.0.0.0 --poll 1000 --proxy-config proxy.compose.conf.json",
    "start": "npm run dev",
    "build": "ng build",
    "lint": "ng lint",
    "typecheck": "ng build --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@better-auth/oauth-provider": "^1.7.2",
    "better-auth": "^1.7.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
